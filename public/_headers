# Cloudflare applies this file to the static assets in ./dist. It is ignored as
# an asset; see https://developers.cloudflare.com/workers/static-assets/headers/
#
# The CSP needs 'unsafe-inline' for scripts and styles because Astro inlines two
# small scripts (the `html.js` flag and the reveal observer) plus the light-mode
# CSS. This is a static page with no forms, no cookies and no user input, so the
# value here is the origin allowlist and frame-ancestors, not script hardening.
#
# `media-src` names the bucket the hero's demo video is pulled from. It has to
# be stated because media-src does not fall back to img-src, and the video is
# fetched only after someone opens the dialog.
#
# `script-src` needs `'wasm-unsafe-eval'` because Pagefind, which serves the docs
# search, compiles a WebAssembly module. Without it the browser refuses to
# instantiate it and the search box fails — and only in production, since
# `astro preview` sends no CSP at all. The keyword is the narrow one: it allows
# WebAssembly and still forbids `eval()`.
#
# `frame-src` names the origin a YouTube embed is served from. The nocookie host
# is the one to use: same player, no tracking cookie until playback.
#
# The two analytics origins appear in both `script-src` and `connect-src`: the
# Cloudflare beacon, and the self-hosted Umami tracker, which posts back to the
# host that served it. Neither beacon sets a cookie, and Umami is scoped to the
# real hostname with `data-domains` so local runs are not counted.
#
# HSTS is set here rather than with the zone's HSTS toggle so the value is
# versioned next to the site. The toggle overrides this file when both are on,
# so it stays off. `includeSubDomains` is safe because the zone's Universal SSL
# certificate already covers *.cogsend.com.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://static.cloudflareinsights.com https://umami.vempus.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' https://assets.deepakness.com; frame-src 'self' https://www.youtube-nocookie.com; font-src 'self'; connect-src 'self' https://cloudflareinsights.com https://umami.vempus.com; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'; upgrade-insecure-requests

# The key page says it cannot send the key anywhere, and this makes that true:
# Cloudflare joins two values of one header with a comma, which a browser reads
# as two policies and enforces both, so this one only takes away. No
# connect-src, no third-party script, no form, no frame. The page also renders
# without analytics (`analytics={false}` in src/pages/key.astro), or the
# blocked beacons would fill the console with errors. `no-transform` keeps
# Cloudflare from injecting its Web Analytics beacon into the HTML on the way
# out, which this policy would block, with an error, just the same.
/key/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'

# Astro's build-hashed assets never change under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Pagefind's index and fragment files carry a content hash in their names, so
# they can be cached hard. The rest of `/pagefind/` — the loader, the worker,
# the WASM — keeps the default: those names never change, and pinning them for a
# year would leave a stale loader pointing at an index it no longer matches.
/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable

# HTML is revalidated so a deploy is picked up immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/sitemap-index.xml
  Cache-Control: public, max-age=3600
