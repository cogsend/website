---
import { Image as ImageIcon, Calendar, ChevronUp, Check, Send, Plus } from '@lucide/astro';
import SocialIcon from './SocialIcon.astro';
---

<div aria-hidden="true" class="relative w-full max-w-3xl mx-auto rounded-[2rem] border border-stone-200/50 bg-[#fafaf9] shadow-[0_20px_40px_-12px_rgb(28_25_23/0.1)] overflow-hidden h-[500px] flex flex-col font-sans">
	
	<!-- Top bar / Fake Browser Header -->
	<div class="h-12 border-b border-stone-200/50 flex items-center px-4 bg-white/50 backdrop-blur-sm gap-2">
		<div class="flex gap-1.5">
			<div class="w-3 h-3 rounded-full bg-stone-300"></div>
			<div class="w-3 h-3 rounded-full bg-stone-300"></div>
			<div class="w-3 h-3 rounded-full bg-stone-300"></div>
		</div>
		<div class="mx-auto text-[11px] font-bold tracking-widest text-stone-500 uppercase">compose</div>
	</div>

	<!-- Scrollable content area -->
	<div class="@container flex-1 p-6 pb-32 relative overflow-hidden">
		<!-- Tabs. Wrap, and don't let a pill shrink: under about 327px the three
		     labels are wider than this pane, and a shrinking "Add override…" was
		     clipped on the frame edge. The margin stays small only while they
		     wrap, so the thread cards stay clear of the dock; once they fit on
		     one line the original gap returns. The frame stays a fixed height —
		     the typing demo must not change it. -->
		<div class="mb-1 flex flex-wrap items-center gap-2 @min-[327px]:mb-6">
			<div class="shrink-0 cursor-default rounded-full bg-stone-900 px-3 py-1.5 text-[12px] font-bold text-white shadow-md whitespace-nowrap">Global</div>
			<div class="flex shrink-0 cursor-default items-center gap-1.5 rounded-full border border-stone-200/80 bg-white px-3 py-1.5 text-[12px] font-bold whitespace-nowrap text-stone-500 shadow-sm">
				<div class="flex h-3.5 w-3.5 items-center justify-center rounded bg-[#6364ff] text-white">
					<SocialIcon platform="mastodon" class="w-2.5 h-2.5 text-white" />
				</div>
				Mastodon
			</div>
			<div class="ml-2 flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full border border-dashed border-stone-300 px-3 py-1.5 text-[12px] font-bold text-stone-500">
				<Plus class="w-3 h-3" /> Add override...
			</div>
		</div>

		<!-- Thread Input 1 -->
		<div class="flex gap-4">
			<div class="hidden sm:flex flex-col items-center shrink-0">
				<!-- Drawn inline rather than fetched: the avatar used to be the page's
				     only third-party request, which made the hero depend on a network
				     round-trip to a service we do not control. -->
				<div class="z-10 flex h-10 w-10 items-center justify-center overflow-hidden rounded-full border-[3px] border-[#fafaf9] bg-stone-200 text-stone-500 shadow-sm">
					<svg viewBox="0 0 40 40" class="h-full w-full" aria-hidden="true">
						<circle cx="20" cy="15.5" r="6.5" fill="currentColor"></circle>
						<path d="M6 40a14 14 0 0 1 28 0Z" fill="currentColor"></path>
					</svg>
				</div>
				<div class="w-0.5 bg-stone-200/80 -mt-2 min-h-[50px] flex-1"></div>
			</div>
			<div class="flex-1 flex flex-col rounded-[1.5rem] border border-stone-200/80 bg-white p-5 shadow-[0_4px_24px_-8px_rgb(28_25_23/0.06)] focus-within:ring-2 focus-within:ring-stone-900/10 transition-all cursor-text" id="mock-editor-area">
				<textarea tabindex="-1" aria-label="Sample post text" class="w-full resize-none bg-transparent text-[15px] font-medium text-stone-900 placeholder:text-stone-500 focus:outline-none" rows="3" placeholder="What's happening?" id="mock-textarea"></textarea>
				
				<div class="mt-3 flex items-center justify-between border-t border-stone-100 pt-3">
					<div class="flex gap-2">
						<div class="flex items-center gap-1.5 rounded-full border border-stone-100 bg-stone-50 px-3 py-1.5 text-[12px] font-bold text-stone-500 hover:text-stone-900 cursor-pointer transition-colors">
							<Plus class="w-3.5 h-3.5" /> Thread
						</div>
					</div>
					<div class="flex items-center gap-3">
						<button tabindex="-1" aria-label="Attach image" class="rounded-lg p-1.5 text-stone-500 transition-colors hover:bg-stone-50 hover:text-stone-900"><ImageIcon class="w-4 h-4" /></button>
						<div class="rounded-full px-2.5 py-1 text-[11px] font-bold tracking-wider border border-stone-100 bg-stone-50 text-stone-500" id="mock-char-count">0/280</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Thread Input 2 (Empty) -->
		<!-- Dimmed with its own colours rather than container `opacity`, which
		     would drag the text below AA. -->
		<div class="mt-6 flex gap-4">
			<div class="hidden sm:flex flex-col items-center shrink-0">
				<div class="z-10 flex h-10 w-10 items-center justify-center rounded-full border-[3px] border-[#fafaf9] bg-stone-100 text-stone-500">
					<Plus class="w-4 h-4" />
				</div>
			</div>
			<div class="flex-1 cursor-text rounded-[1.5rem] border border-stone-200/60 bg-stone-50/60 p-5 transition-colors hover:bg-white">
				<div class="text-[15px] font-medium text-stone-500">Add another post...</div>
			</div>
		</div>

	</div>

	<!-- Floating Bottom Action Dock -->
	<!-- flex-wrap is load-bearing: on a 320px screen the two groups are wider
	     than the dock, and without wrapping they are clipped by the frame's
	     overflow-hidden. The avatar stack is dropped below `sm` for the same
	     reason — the count carries the meaning on its own. -->
	<div class="absolute bottom-6 left-1/2 z-30 flex w-full max-w-[94%] -translate-x-1/2 flex-wrap items-center justify-center gap-2 pointer-events-none sm:gap-4">
		
		<!-- Account Selector -->
		<div class="relative pointer-events-auto flex items-center" id="mock-accounts-container">
			<button tabindex="-1" id="mock-accounts-toggle" aria-expanded="false" class="flex items-center gap-2 rounded-full border border-stone-200/80 bg-white/95 px-4 py-2.5 text-[13px] font-bold text-stone-700 shadow-[0_16px_40px_-12px_rgb(28_25_23/0.15)] backdrop-blur-xl transition-all hover:border-stone-300">
				<div class="mr-0.5 hidden -space-x-1.5 sm:flex">
					<div class="w-5 h-5 rounded-full border-2 border-white bg-black z-30 flex items-center justify-center">
						<SocialIcon platform="x" class="w-2.5 h-2.5 text-white" />
					</div>
					<div class="w-5 h-5 rounded-full border-2 border-white bg-[#6364ff] z-20 flex items-center justify-center">
						<SocialIcon platform="mastodon" class="w-2.5 h-2.5 text-white" />
					</div>
					<div class="w-5 h-5 rounded-full border-2 border-white bg-[#1185fe] z-20 flex items-center justify-center">
						<SocialIcon platform="bluesky" class="w-2.5 h-2.5 text-white" />
					</div>
					<div class="w-5 h-5 rounded-full border-2 border-white bg-[#0a66c2] z-10 flex items-center justify-center">
						<SocialIcon platform="linkedin" class="w-2.5 h-2.5 text-white" />
					</div>
				</div>
				<span>4 selected</span>
				<ChevronUp class="ml-1 w-3.5 h-3.5 text-stone-500 transition-transform" id="mock-accounts-icon" />
			</button>

			<!-- Accounts Popover -->
		</div>

		<!-- Publish Group -->
		<div class="relative pointer-events-auto flex items-center rounded-full bg-stone-900 text-white shadow-[0_16px_40px_-12px_rgb(28_25_23/0.3)]">
			<button tabindex="-1" id="mock-publish-toggle" aria-expanded="false" aria-controls="mock-publish-popover" class="flex cursor-pointer items-center gap-2 rounded-l-full px-6 py-2.5 text-[13px] font-bold hover:bg-stone-800 transition-colors">
				<span>Publish</span>
			</button>
			<div class="h-5 w-px bg-stone-700/80"></div>
			<button tabindex="-1" aria-label="Schedule instead" class="flex items-center justify-center rounded-r-full px-4 py-2.5 hover:bg-stone-800 transition-colors">
				<Calendar class="w-4 h-4 text-stone-300" />
			</button>

			<!-- Post Confirmation Popover -->
		</div>

	</div>

	<!-- Both popovers are anchored to the frame rather than to their button.
	     A 224px panel centred on a button that sits at the left of the dock
	     hangs off the edge of a 272px-wide frame on a 320px screen, and the
	     frame clips it. Centred in the frame it always fits. -->
	<div id="mock-accounts-popover" role="dialog" aria-label="Accounts" class="absolute bottom-32 left-1/2 z-40 hidden w-56 -translate-x-1/2 translate-y-2 rounded-[1.5rem] border border-stone-200/80 bg-white p-2 shadow-[0_16px_40px_-12px_rgb(28_25_23/0.15)] opacity-0 transition-all duration-200 sm:bottom-24 sm:w-72">
		<div class="mb-2 flex items-center justify-between border-b border-stone-100 px-3 py-2">
			<span class="text-[11px] font-bold tracking-widest text-stone-500 uppercase">Accounts</span>
			<button tabindex="-1" class="rounded-md bg-stone-100 px-2.5 py-1 text-[11px] font-bold text-stone-700 transition hover:bg-stone-200 hover:text-stone-900">Clear all</button>
		</div>
		<div class="space-y-1 px-1 pb-2">
			<div class="group flex w-full items-center gap-1 rounded-xl px-2 py-1.5 bg-stone-50/80">
				<button tabindex="-1" class="flex min-w-0 flex-1 items-center gap-3 text-left">
					<div class="w-6 h-6 rounded-full bg-black flex items-center justify-center shrink-0">
						<SocialIcon platform="x" class="w-3 h-3 text-white" />
					</div>
					<span class="min-w-0 flex-1 truncate text-[13px] font-bold text-stone-900">@x_user</span>
					<span class="flex h-4 w-4 shrink-0 items-center justify-center rounded border border-stone-900 bg-stone-900 text-white"><Check class="w-3 h-3" /></span>
				</button>
			</div>
			<div class="group flex w-full items-center gap-1 rounded-xl px-2 py-1.5 bg-stone-50/80">
				<button tabindex="-1" class="flex min-w-0 flex-1 items-center gap-3 text-left">
					<div class="w-6 h-6 rounded-full bg-[#6364ff] flex items-center justify-center shrink-0">
						<SocialIcon platform="mastodon" class="w-3 h-3 text-white" />
					</div>
					<span class="min-w-0 flex-1 truncate text-[13px] font-bold text-stone-900">@mastodon_user</span>
					<span class="flex h-4 w-4 shrink-0 items-center justify-center rounded border border-stone-900 bg-stone-900 text-white"><Check class="w-3 h-3" /></span>
				</button>
			</div>
			<div class="group flex w-full items-center gap-1 rounded-xl px-2 py-1.5 bg-stone-50/80">
				<button tabindex="-1" class="flex min-w-0 flex-1 items-center gap-3 text-left">
					<div class="w-6 h-6 rounded-full bg-[#1185fe] flex items-center justify-center shrink-0">
						<SocialIcon platform="bluesky" class="w-3 h-3 text-white" />
					</div>
					<span class="min-w-0 flex-1 truncate text-[13px] font-bold text-stone-900">@bsky_user</span>
					<span class="flex h-4 w-4 shrink-0 items-center justify-center rounded border border-stone-900 bg-stone-900 text-white"><Check class="w-3 h-3" /></span>
				</button>
			</div>
			<div class="group flex w-full items-center gap-1 rounded-xl px-2 py-1.5 bg-stone-50/80">
				<button tabindex="-1" class="flex min-w-0 flex-1 items-center gap-3 text-left">
					<div class="w-6 h-6 rounded-full bg-[#0a66c2] flex items-center justify-center shrink-0">
						<SocialIcon platform="linkedin" class="w-3 h-3 text-white" />
					</div>
					<span class="min-w-0 flex-1 truncate text-[13px] font-bold text-stone-900">LinkedIn Profile</span>
					<span class="flex h-4 w-4 shrink-0 items-center justify-center rounded border border-stone-900 bg-stone-900 text-white"><Check class="w-3 h-3" /></span>
				</button>
			</div>
			<div class="group flex w-full items-center gap-1 rounded-xl px-2 py-1.5 hover:bg-stone-50/50 transition-colors">
				<button tabindex="-1" class="flex min-w-0 flex-1 items-center gap-3 text-left">
					<div class="w-6 h-6 rounded-full bg-[#000000] flex items-center justify-center shrink-0">
						<SocialIcon platform="threads" class="w-3.5 h-3.5 text-white" />
					</div>
					<span class="min-w-0 flex-1 truncate text-[13px] font-bold text-stone-600">@threads_user</span>
					<span class="flex h-4 w-4 shrink-0 items-center justify-center rounded border border-stone-200 text-transparent"><Check class="w-3 h-3" /></span>
				</button>
			</div>
			<div class="group flex w-full items-center gap-1 rounded-xl px-2 py-1.5 hover:bg-stone-50/50 transition-colors">
				<button tabindex="-1" class="flex min-w-0 flex-1 items-center gap-3 text-left">
					<div class="w-6 h-6 rounded-full bg-[#e4405f] flex items-center justify-center shrink-0">
						<SocialIcon platform="instagram" class="w-3 h-3 text-white" />
					</div>
					<span class="min-w-0 flex-1 truncate text-[13px] font-bold text-stone-600">@instagram_user</span>
					<span class="flex h-4 w-4 shrink-0 items-center justify-center rounded border border-stone-200 text-transparent"><Check class="w-3 h-3" /></span>
				</button>
			</div>
		</div>
	</div>

	<div id="mock-publish-popover" role="dialog" aria-label="Confirm post" class="absolute bottom-32 left-1/2 z-40 hidden w-64 -translate-x-1/2 translate-y-2 rounded-[1.5rem] border border-stone-200/80 bg-white/95 p-3 text-stone-900 shadow-[0_12px_40px_-12px_rgb(28_25_23/0.15)] backdrop-blur-xl transition-all duration-200 opacity-0 sm:bottom-24">
		<div class="px-2 pt-2 pb-4 text-center">
			<p class="mb-1 text-[14px] font-extrabold text-stone-900">Confirm post</p>
			<p class="text-[12px] font-medium text-stone-500">Publishing to 4 accounts.</p>
		</div>
		<div class="mb-4 flex justify-center -space-x-2">
			<div class="relative flex h-8 w-8 items-center justify-center rounded-full border-2 border-white bg-stone-50 shadow-sm">
				<SocialIcon platform="x" class="w-3.5 h-3.5 text-black" />
			</div>
			<div class="relative flex h-8 w-8 items-center justify-center rounded-full border-2 border-white bg-stone-50 shadow-sm">
				<SocialIcon platform="mastodon" class="w-3.5 h-3.5 text-[#6364ff]" />
			</div>
			<div class="relative flex h-8 w-8 items-center justify-center rounded-full border-2 border-white bg-stone-50 shadow-sm">
				<SocialIcon platform="bluesky" class="w-3.5 h-3.5 text-[#1185fe]" />
			</div>
			<div class="relative flex h-8 w-8 items-center justify-center rounded-full border-2 border-white bg-stone-50 shadow-sm">
				<SocialIcon platform="linkedin" class="w-3.5 h-3.5 text-[#0a66c2]" />
			</div>
		</div>
		<button tabindex="-1" id="mock-publish-action-btn" class="flex w-full cursor-pointer items-center justify-center gap-2 rounded-full bg-stone-900 py-2.5 text-[13px] font-bold text-white shadow-sm transition-all hover:bg-stone-800">
			Publish now
			<Send class="w-3.5 h-3.5" />
		</button>
		<button tabindex="-1" id="mock-keep-editing-btn" class="mt-1 w-full rounded-full py-1.5 text-[12px] font-bold text-stone-600 transition-colors hover:text-stone-900">
			Keep editing
		</button>
		<label class="mt-1 flex items-center justify-center gap-1.5 text-[11px] font-medium text-stone-500 cursor-pointer hover:text-stone-700">
			<input tabindex="-1" type="checkbox" />
			Publish without asking next time
		</label>
	</div>
</div>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const textarea = document.getElementById('mock-textarea') as HTMLTextAreaElement;
		const count = document.getElementById('mock-char-count');

		const accToggle = document.getElementById('mock-accounts-toggle');
		const accPopover = document.getElementById('mock-accounts-popover');
		const accIcon = document.getElementById('mock-accounts-icon');

		const pubToggle = document.getElementById('mock-publish-toggle');
		const pubPopover = document.getElementById('mock-publish-popover');
		const keepEditing = document.getElementById('mock-keep-editing-btn');
		const pubAction = document.getElementById('mock-publish-action-btn');

		let accOpen = false;
		let pubOpen = false;

		/** Set once the visitor touches the box: after that the demo never runs
		 *  again, so it can never write over text someone is typing. */
		let handedOver = false;

		// The mock is a picture of the app, so the typing is pure decoration.
		// Honour the OS setting by drawing the finished state instead.
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		const demoText =
			'Scheduled posts that fail now retry on their own, and Insights groups the failures by reason. What changed, in the thread below 👇';

		let typeInterval: ReturnType<typeof setInterval> | undefined;
		let typeTimeout: ReturnType<typeof setTimeout> | undefined;
		let i = 0;

		const updateCount = () => {
			if (!textarea || !count) return;
			count.textContent = `${textarea.value.length}/280`;
			textarea.style.height = 'auto';
			textarea.style.height = `${textarea.scrollHeight}px`;
		};

		function stopTyping() {
			if (typeInterval) clearInterval(typeInterval);
			if (typeTimeout) clearTimeout(typeTimeout);
			typeInterval = undefined;
			typeTimeout = undefined;
			textarea?.removeAttribute('data-mock-typing');
		}

		function fillImmediately() {
			stopTyping();
			if (!textarea) return;
			textarea.value = demoText;
			updateCount();
		}

		function startTyping() {
			if (!textarea || handedOver) return;
			if (reduceMotion.matches) return fillImmediately();
			stopTyping();
			textarea.value = '';
			textarea.setAttribute('data-mock-typing', '');
			updateCount();
			i = 0;

			typeInterval = setInterval(() => {
				if (!textarea || handedOver) return stopTyping();
				if (i >= demoText.length) return stopTyping();
				textarea.value += demoText.charAt(i);
				updateCount();
				i++;
			}, 40);
		}

		function handOver() {
			if (handedOver) return;
			handedOver = true;
			stopTyping();
		}

		textarea?.addEventListener('pointerdown', handOver);
		textarea?.addEventListener('keydown', handOver);
		textarea?.addEventListener('input', () => {
			handOver();
			updateCount();
		});

		const observer = new IntersectionObserver((entries) => {
			if (!entries[0]?.isIntersecting) return;
			startTyping();
			observer.disconnect();
		});
		if (textarea) observer.observe(textarea);
		// With reduced motion there is nothing to wait for; show it right away.
		if (reduceMotion.matches) fillImmediately();

		// Popovers toggle logic
		function toggleAccounts() {
			if (pubOpen) closePublish();
			accOpen = !accOpen;
			if (accOpen) {
				accToggle?.setAttribute('aria-expanded', 'true');
				accPopover?.classList.remove('hidden');
				// trigger reflow
				void accPopover?.offsetWidth;
				accPopover?.classList.remove('opacity-0', 'translate-y-2');
				accToggle?.classList.add('bg-stone-50', 'border-stone-300');
				accToggle?.classList.remove('bg-white/95');
				accIcon?.classList.add('rotate-180');
			} else {
				closeAccounts();
			}
		}

		function closeAccounts() {
			accOpen = false;
			accToggle?.setAttribute('aria-expanded', 'false');
			accPopover?.classList.add('opacity-0', 'translate-y-2');
			accToggle?.classList.remove('bg-stone-50', 'border-stone-300');
			accToggle?.classList.add('bg-white/95');
			accIcon?.classList.remove('rotate-180');
			setTimeout(() => {
				if (!accOpen) accPopover?.classList.add('hidden');
			}, 200);
		}

		function togglePublish() {
			if (accOpen) closeAccounts();
			pubOpen = !pubOpen;
			if (pubOpen) {
				pubToggle?.setAttribute('aria-expanded', 'true');
				pubPopover?.classList.remove('hidden');
				void pubPopover?.offsetWidth;
				pubPopover?.classList.remove('opacity-0', 'translate-y-2');
			} else {
				closePublish();
			}
		}

		function closePublish() {
			pubOpen = false;
			pubToggle?.setAttribute('aria-expanded', 'false');
			pubPopover?.classList.add('opacity-0', 'translate-y-2');
			setTimeout(() => {
				if (!pubOpen) pubPopover?.classList.add('hidden');
			}, 200);
		}

		accToggle?.addEventListener('click', (e) => {
			e.stopPropagation();
			toggleAccounts();
		});

		pubToggle?.addEventListener('click', (e) => {
			e.stopPropagation();
			togglePublish();
		});

		keepEditing?.addEventListener('click', (e) => {
			e.stopPropagation();
			closePublish();
		});

		pubAction?.addEventListener('click', (e) => {
			e.stopPropagation();
			closePublish();

			const mainBtn = document.getElementById('mock-publish-toggle');
			if (mainBtn) {
				// "Saving…" is the label the real composer uses while it works.
				mainBtn.innerHTML = reduceMotion.matches
					? '<span>Saving…</span>'
					: '<span class="flex items-center gap-2"><svg class="w-3.5 h-3.5 animate-spin" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>Saving…</span>';
			}

			setTimeout(() => {
				if (mainBtn) mainBtn.innerHTML = '<span>Publish</span>';
				// Only replay the demo if the visitor has not taken the box over.
				if (!handedOver) {
					typeTimeout = setTimeout(() => startTyping(), 1000);
				}
			}, 1500);
		});

		// Escape closes whichever popover is open, like the real dialogs.
		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return;
			if (accOpen) closeAccounts();
			if (pubOpen) closePublish();
		});

		// Close popovers on click outside
		document.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			if (accOpen && !accPopover?.contains(target)) {
				closeAccounts();
			}
			if (
				pubOpen &&
				!pubPopover?.contains(target) &&
				target.id !== 'mock-publish-toggle' &&
				!pubToggle?.contains(target)
			) {
				closePublish();
			}
		});
	});
</script>
