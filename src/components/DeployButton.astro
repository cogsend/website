---
import { LINKS } from '../config';
import { cloudflareLogo, nextLogoId } from '../cloudflare-logo.mjs';

interface Props {
	size?: 'md' | 'lg';
	class?: string;
}
const { size = 'lg', class: className = '' } = Astro.props;

/**
 * The site's own Deploy to Cloudflare button. Cloudflare's badge image is
 * served from their domain, which the CSP in public/_headers does not let a
 * page load images from, and it would not match the rest of the page anyway.
 * The cloud is the badge's own logo (src/cloudflare-logo.mjs).
 */
const sizes = {
	md: 'px-5 py-2.5 text-[13px] gap-2',
	lg: 'px-7 py-3.5 text-[15px] gap-2.5'
};
---

<a
	href={LINKS.deployButton}
	class={`inline-flex items-center rounded-full bg-stone-900 font-bold text-white shadow-ink transition-all hover:-translate-y-0.5 hover:bg-stone-800 ${sizes[size]} ${className}`}
>
	<Fragment set:html={cloudflareLogo(nextLogoId(), size === 'lg' ? 26 : 22)} />
	Deploy to Cloudflare
</a>
