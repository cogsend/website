---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LINKS } from '../config';
---

<Layout
	title="Generate an encryption key — CogSend"
	description="Generate the APP_ENCRYPTION_KEY a CogSend instance needs, in your browser. Nothing is sent anywhere."
>
	<Header />
	<main id="main" class="mx-auto w-full max-w-2xl flex-1 px-6 py-20 sm:py-28">
		<p class="text-[14px] font-bold tracking-widest text-stone-500 uppercase">Deploy</p>
		<h1
			class="mt-4 text-[2.25rem] leading-tight font-extrabold tracking-tight text-stone-900 sm:text-[2.75rem]"
		>
			Your encryption key
		</h1>
		<p class="mt-4 text-[16px] leading-relaxed font-medium text-stone-500">
			Paste this into the <code class="font-mono text-stone-800">APP_ENCRYPTION_KEY</code> field when
			you deploy CogSend. It was generated in this browser and has not been sent anywhere.
		</p>

		<div class="mt-8 rounded-[1.5rem] border border-stone-200 bg-white p-5 shadow-pill">
			<output
				id="key"
				class="block font-mono text-[15px] leading-relaxed font-bold break-all text-stone-900 select-all"
				aria-live="polite">Generating…</output
			>
			<div class="mt-4 flex flex-wrap items-center gap-3">
				<button
					id="copy"
					type="button"
					class="rounded-full bg-stone-900 px-6 py-3 text-[13px] font-bold text-white shadow-ink transition-all hover:-translate-y-0.5 hover:bg-stone-800"
				>
					Copy
				</button>
				<button
					id="regenerate"
					type="button"
					class="rounded-full border border-stone-200 bg-white px-6 py-3 text-[13px] font-bold text-stone-700 shadow-pill transition-all hover:-translate-y-0.5 hover:border-stone-300 hover:text-stone-900"
				>
					Generate another
				</button>
				<span id="status" class="text-[13px] font-bold text-stone-500" role="status"></span>
			</div>
		</div>

		<h2 class="mt-12 text-[1.25rem] font-extrabold tracking-tight text-stone-900">
			Save it before you continue
		</h2>
		<ul class="mt-4 list-disc space-y-2 pl-5 text-[15px] leading-relaxed font-medium text-stone-600">
			<li>
				Your first visit to the new instance asks for it again, to prove the instance is yours before
				it creates your account.
			</li>
			<li>
				It encrypts the account tokens CogSend stores. Nothing can recover it, and replacing it means
				reconnecting every account, so keep it in your password manager.
			</li>
			<li>Treat it like a password: anyone holding it and your database can read those tokens.</li>
		</ul>
		<p class="mt-8 text-[15px] leading-relaxed font-medium text-stone-500">
			Prefer a terminal? <code class="font-mono text-stone-800">openssl rand -hex 32</code> makes
			the same kind of key. Next: <a
				href={`${LINKS.docs}deploy/`}
				class="font-bold text-stone-900 underline underline-offset-2">the deploy guide</a
			>.
		</p>
	</main>
	<Footer />
</Layout>

<script>
	// 32 random bytes as 64 hex characters: what `openssl rand -hex 32` prints,
	// and what the app reads as a raw 256-bit key.
	function generate(): string {
		const bytes = crypto.getRandomValues(new Uint8Array(32));
		return Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
	}

	const output = document.getElementById('key');
	const status = document.getElementById('status');

	function show() {
		if (output) output.textContent = generate();
		if (status) status.textContent = '';
	}

	document.getElementById('regenerate')?.addEventListener('click', show);
	document.getElementById('copy')?.addEventListener('click', async () => {
		if (!output || !status) return;
		try {
			await navigator.clipboard.writeText(output.textContent ?? '');
			status.textContent = 'Copied';
		} catch {
			status.textContent = 'Select the key and copy it by hand';
		}
	});

	show();
</script>
